# =========================================================
# SERVER
# =========================================================
NODE_ENV=development
PORT=4000

# Public storefront origin — used for canonical URLs.
SITE_URL=https://worldwidecoupons.com
SITE_NAME=WorldwideCoupons

# Set to true when the API sits behind nginx / a load balancer, so req.ip
# (and therefore rate limiting) reads the forwarded address rather than the
# proxy's own.
TRUST_PROXY=false

# =========================================================
# DATABASE
# =========================================================
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/worldwidecoupons

# =========================================================
# AUTH
# =========================================================
# Minimum 16 characters. Rotating it signs everybody out.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
SITE_JWT_EXPIRE=30d

# Browsers that may call this API with credentials. Comma separated.
# Any localhost port is allowed automatically outside production.
CORS_ORIGINS=https://worldwidecoupons.com,https://www.worldwidecoupons.com,https://admin.worldwidecoupons.com

# =========================================================
# MEDIA (optional — upload endpoints disable themselves without it)
# =========================================================
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=worldwidecoupons

# =========================================================
# MAIL (optional — contact replies are saved either way)
# =========================================================
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=WorldwideCoupons <no-reply@worldwidecoupons.com>

# =========================================================
# AFFILIATE LINKS
# =========================================================
# Appended to every outbound link that has no store-level override,
# e.g. utm_source=worldwidecoupons&utm_medium=affiliate
DEFAULT_TRACKING_PARAMS=

# Used to guess a store logo from its domain when none was uploaded.
LOGO_SERVICE=https://logo.clearbit.com

# =========================================================
# BACKGROUND WORK
# =========================================================
# Hourly expiry sweep + six-hourly counter refresh.
ENABLE_CRON=true
ENABLE_REQUEST_LOG=true
