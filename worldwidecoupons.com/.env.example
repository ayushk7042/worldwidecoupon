NEXT_PUBLIC_API_URL=http://localhost:4040/api

# Local dev: this app on :3000. Production: https://worldwidecoupons.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=WorldwideCoupons
